// RainParticles.compute —— 阶段 2:最小 compute 管线(手写,不搬 SP2 的 DXBC)
//
// 【范围】(计划文档 §5 阶段 2.1)先只写三个 kernel:
//   Randomize   首次分配时初始化每粒子的随机数据与球域位置(确定性种子,与 _time 无关)
//   Positioning 每帧积分下落(阶段 2 只做"竖直下落 + 域环绕",径向/风/速度留到阶段 5)
//   FillArgs    统计活跃粒子数写入 _ArgsBuffer.instanceCount(原子加;
//               复位由 CPU 每帧 SetData 完成 —— 阶段 2 无剔除,跨 threadgroup 复位不可靠)
//
// 【铁律约束(2026-09-29 真机编译错误实锤,已纠正)】
//   - 原子加:**必须用带下标的 RWStructuredBuffer<uint> 2/3 参形式**
//     InterlockedAdd(_ArgsBuffer[1], 1, original);
//     RWByteAddressBuffer 的 4 参 InterlockedAdd 在本游戏编译器**不存在**:
//     Editor.log 报 "InterlockedAdd: no matching 4 parameter intrinsic function;
//     Possible intrinsic functions are: InterlockedAdd(int|uint, uint)
//     InterlockedAdd(int|uint, uint, out int|uint original)"
//     —— 旧结论"RWStructuredBuffer<uint> 无 InterlockedAdd、必须用 RWByteAddressBuffer"是**错的**,
//       已纠正。且:一个 kernel 编译失败会毒掉**整个** compute(所有 kernel 全部 invalid)。
//   - compute 没有 _Time,自加 _time uniform
//   - 线程组大小 64(_threadGroupSize,SP2 同款)
//
// 【阶段 2.3 验证入口】_testRow == 1 时 Positioning 覆盖位置为相机前方一排等距点:
//   位置 = domainCenter + camRight*(i*spacing - span/2) + camUp*0.5 + camFwd*6
//   SV_InstanceID 数据流正确 → 屏幕上一排逐渐分开的色块;全重叠 → 实例号恒 0(改路径)。

#pragma kernel Randomize
#pragma kernel Positioning
#pragma kernel TranslateFixed
#pragma kernel FillArgs

RWStructuredBuffer<float4> _Positions;   // xyz = 世界(相机域)位置;w = 执行探针(_time)
RWStructuredBuffer<float4> _RandomData;  // x = 随机种子;yzw 备用
RWStructuredBuffer<uint> _ArgsBuffer;    // 5×uint 间接绘制参数(args[1] = instanceCount)
RWStructuredBuffer<uint> _DiagBuffer;    // 诊断计数:x0 = 本帧重生次数(CPU 每帧 SetData 复位)

float _time;
float _dt;
float3 _domainCenter;   // 相机位置(阶段 2 的域中心,世界坐标)
float _domainRadius;    // 域半径(阶段 4 前用固定值)
float _fallSpeed;       // 15 m/s(SP2 _fallSpeed)
float3 _downDir;        // 径向"下" = 指向行星中心(帧空间,craft.GravityNormal)
                        //  坐标系铁律(jnoCode ReferenceFrame/GravityNormal 实锤):
                        //   世界(帧)空间是浮点原点+绕行星Y轴旋转,重力径向 → "下"随球面位置变,
                        //   不是世界 (0,-1,0)!球面赤道处径向"下"≈世界水平。
float3 _translation;    // 换帧原点重定位平移量(TranslateFixed kernel;SP2 FloatingOriginChanged
                        //   → TranslateParticles(e.OldFloatingOriginOffset - e.NewFloatingOriginOffset))
uint _capacity;         // buffer 容量(固定,重建才变)
uint _amount;           // 活跃粒子数(阶段 2 = _capacity;阶段 4 引入 amount 分离)
uint _indexCountPerInstance;  // 12(十字四边形)

// 相机基(阶段 2.3 的等距排用;阶段 3 的构轴也要)
float3 _camRight;
float3 _camUp;
float3 _camFwd;

// 阶段 2.3:1 = 覆盖为相机前等距排(验证 SV_InstanceID 数据流)
uint _testRow;
float _testRowSpacing;

// 出域处置模式:1 = 穿过球心镜像(SP2 风格,确定性,默认);0 = 球内均匀随机(旧,近旁爆闪)
uint _respawnMode;

// ---------- 简单确定性 hash(阶段 2 够用;Phase 4 如需图集随机再加维度) ----------

float Hash11(float p)
{
    p = frac(p * 0.1031f);
    p *= p + 33.33f;
    p *= p + p;
    return frac(p);
}

// 均匀球面方向(近似:两个 hash 构造单位向量)
float3 RandomUnitVector(float seed)
{
    float theta = Hash11(seed) * 6.2831853f;
    float phi = acos(2.0f * Hash11(seed + 1.7f) - 1.0f);
    return float3(sin(phi) * cos(theta), cos(phi), sin(phi) * sin(theta));
}

// 域内随机重生位置(**体积均匀**,但在 [0.15R, R] 的壳层内 —— 避开"紧贴镜头凭空冒出")
//   r = R * (lerp(inner³, 1, u))^(1/3) → 壳层内体积均匀;被排除的核心只占体积的 0.3%,密度无感。
//    随机(而非确定性镜像)是"像真雨"的关键:确定性处置会让整片雨**零混合** →
//   初始的任何一簇粒子永远成团、周期性地一起落下来(实测反馈"雨像下面条一样集中一股脑下降";
//   静止时周期 = 2R/下落速度 ≈ 6.7s,飞行时缩到 0.6s = 高频脉动)。
float3 RandomSpawnInside(float seed, float phase)
{
    const float inner = 0.15f;
    float3 nd = RandomUnitVector(seed + phase * 7.13f);
    float u = Hash11(seed + phase * 3.7f);
    float r = pow(lerp(inner * inner * inner, 1.0f, u), 0.3333333f) * _domainRadius;
    return _domainCenter + nd * r;
}

// ---------- Randomize:首次分配时初始化(只跑一次) ----------

[numthreads(64, 1, 1)]
void Randomize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _capacity) return;
    float seed = (float)id.x * 7.13f + 1.0f;
    _RandomData[id.x] = float4(seed, 0, 0, 0);
    float3 dir = RandomUnitVector(seed);
    //  体积均匀:半径必须 R*u^(1/3)(u 均匀),不能用 R*u ——
    //   R*u 的体密度 ∝ 1/r²,粒子全挤在球心("雨是一团"的另一半原因),
    //   且镜头附近过密 → 垂直往下看时糊满屏幕的帮凶。
    float u = Hash11(seed + 3.3f);
    float r = pow(u, 0.3333333f) * _domainRadius;
    _Positions[id.x] = float4(_domainCenter + dir * r, 0);
}

// ---------- Positioning:每帧积分 + 域环绕 ----------

[numthreads(64, 1, 1)]
void Positioning(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _capacity) return;

    if (_testRow == 1u)
    {
        // 阶段 2.3:相机前方一排等距点 —— 验证 SV_InstanceID → buffer 索引 → 实例化绘制。
        // 相机系锁定(每帧用 camPos+cam基 重算,天然跟着相机,这就是"沾在摄像机上"的原因,设计使然)。
        // 距离 30m、间距 3m:30m 处 fov20° 可见约 ±9m → 20 粒里可见 6~7 根、间隔 5.7°,肉眼可数。
        float span = (float)_amount * _testRowSpacing;
        float3 rowPos = _domainCenter
            + _camRight * ((float)id.x * _testRowSpacing - span * 0.5f)
            + _camUp * 0.5f
            + _camFwd * 30.0f;
        _Positions[id.x] = float4(rowPos, 0);
        return;
    }

    float4 p = _Positions[id.x];

    // 下落方向防御:compute 内再兜一次(零/NaN → 世界下)。外部传坏值会把整片雨冻死
    // (相对位置冻结 = "雨贴在摄像机上"的表象之一)。!(!(NaN>eps)) 对 NaN 也成立,不用 isnan。
    float3 down = _downDir;
    if (!(dot(down, down) > 1e-6f)) down = float3(0, -1, 0);
    down = normalize(down);

    // 阶段 2:沿径向"下"下落(**世界系下落**,与 SP2 同款:`_particleVel = dt*(风+下落)`)。
    //  2026-09-29 第三轮真机根因:旧实现额外加 camVel(云锁相机)让整片雨"贴"在镜头上
    //   (转镜头/缩放都跟着动,不像独立物体)。SP2 粒子是世界系下落 + 出球重生,域随相机重定位 ——
    //   相机速度**不参与位置积分**(只参与雨丝朝向 AlignStreaks),这才是"独立物品"感的来源。
    //   风、_frameVel → 阶段 5;换帧原点重定位 → TranslateFixed kernel。
    p.xyz += (down * _fallSpeed) * _dt;

    // 球域环绕:超出半径 → 随机重生在球内(保持均匀密度)。
    //  2026-09-29 真机根因:旧实现 frac(dist/R)*R 把从边界缓慢飘出的粒子回收到
    //   frac(≈1.0)≈0 的近中心处,高速飞行下整团云逐渐坍缩到相机上
    //   ("竖线贴在摄像机上",pos 回读 4m 簇 + 相对位置逐字节冻结 = 坍缩后的冻结态);
    //   随机重生无此问题。相位 floor(_time*20) 保证每粒子重生一次位置稳定,不每帧乱跳。
    //  2026-09-29 第二轮根因:这里**不要读 _RandomData** —— 该 buffer 只绑了 Randomize
    //   kernel,在 Positioning 里读未绑定的 StructuredBuffer 会让本 kernel 在真机整段空转
    //   (实测:整团雨冻死在初始随机位,连 camVel 锁都失效,pos0Δ 恒 0);
    //   seed 直接用 id.x 派生(与 Randomize 同公式,每粒子稳定)。
    float3 d = p.xyz - _domainCenter;
    float dist = length(d);
    if (dist > _domainRadius)
    {
        if (_respawnMode == 1u)
        {
            // 确定性"穿过球心镜像"(SP2 元数据里没有随机 buffer 时的一种可能实现)。
            //  **不推荐**:确定性 + 同速下落 = 整片雨零混合 → 初始的每一簇粒子永远成团,
            //   周期性一起落下来("像下面条一样集中一股脑下降";静止周期 ≈ 6.7s,飞行时 0.6s)。
            //   保留此分支仅用于对照实验(_respawnMode=1);默认走随机(分支 else)。
            float3 n = dist > 1e-4f ? d / dist : float3(0, 1, 0);
            p.xyz = _domainCenter - n * _domainRadius * 0.999f;
        }
        else
        {
            // ★ 默认:**域内随机重生**(体积均匀、避开镜头近旁)→ 持续混合,连续雨帘,无周期团块。
            float seed = (float)id.x * 7.13f + 1.0f;
            float ph = floor(_time * 20.0f);
            p.xyz = RandomSpawnInside(seed, ph);
        }
        // 诊断:重生计数(CPU 每帧复位;回读 _DiagBuffer[0] → 重生率,判断回收是否在工作)
        InterlockedAdd(_DiagBuffer[0], 1u);
    }
    p.w = _time;   // 执行探针:回读 pos[0].w 应随帧变化;恒不变 = 本 kernel 没在跑
    _Positions[id.x] = p;
}

// ---------- TranslateFixed:换帧原点重定位(所有粒子平移 delta;SP2 TranslateFixed 同款) ----------
// 世界系下落的位置存在帧空间坐标里:行星/世界换帧原点时(浮点原点重定位),整个世界平移了 delta,
// 粒子必须一起平移,否则整片雨会相对世界"跳"到别处(SP2 由 FloatingOriginChanged 事件驱动)。

[numthreads(64, 1, 1)]
void TranslateFixed(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _capacity) return;
    float4 p = _Positions[id.x];
    p.xyz += _translation;
    _Positions[id.x] = p;
}

// ---------- FillArgs:统计活跃粒子数(原子加;复位在 CPU) ----------

[numthreads(64, 1, 1)]
void FillArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _amount) return;   // 只数活跃粒子(阶段 2 全活跃;阶段 4 起 amount 可 < capacity)
    uint original;
    // 注意:必须用带下标的 RWStructuredBuffer 3 参形式(本游戏编译器没有 4 参字节寻址原子加)
    InterlockedAdd(_ArgsBuffer[1], 1, original);   // args[1] = instanceCount
}
