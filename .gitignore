# Root allowlist: keep only the directories and files shown in the repository.
/*
!/Assets/
!/docs/

# Local path mapping must never be committed.
/docs/LOCAL_PATHS.md

# Keep existing exclusions inside the allowed directories.
.idea/
.vsconfig
.utmp/
.vs/
.gradle/
.consulo/
ExportedObj/
Decompiled/
ModAssetBundles/
*.log
*.blend1
*.blend1.meta
*.DotSettings.user
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties
InitTestScene*.unity*
*.jpg
*.png
*.ps1

# Local plugins, mod tools and generated Unity assets.
/Assets/Plugins/**/*.dll
/Assets/Plugins/**/*.pdb
/Assets/Plugins/**/*.mdb
/Assets/Plugins/**/*.meta
/Assets/Plugins/**/*.xml
/Assets/Plugins/Editor/JetBrains*
/Assets/ModTools/
/Assets/StreamingAssets/aa*
/Assets/AddressableAssetsData/link.xml*
/Assets/AddressableAssetsData/*/*.bin*
/Assets/Addressables_Temp*
/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/Assets/InitTestScene*.unity*

# Exact root-file exceptions; these take precedence over extension rules.
!/.gitattributes
!/.gitignore
!/README.md
!/Volken2.sln.DotSettings.user
!/version.txt
